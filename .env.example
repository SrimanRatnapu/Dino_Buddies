# Copy to .env.local for local dev. Never commit real keys.

# 1 = return fixtures from /fixtures/describe.json instead of calling Gemini.
MOCK=1
# Optional fake latency in mock mode (ms), to test the "looking now" cue.
MOCK_DELAY_MS=0

# Gemini API key from https://aistudio.google.com/apikey (server-side only).
GEMINI_API_KEY=

# OR, instead of a key: Vertex AI with Application Default Credentials.
# Run `gcloud auth application-default login` once, enable the Vertex AI API
# (aiplatform.googleapis.com) on the project, then set these. Billed to the
# project's Cloud Billing account, not AI Studio credits.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Model name. Check `npm run models` for what your key can use; names get retired.
GEMINI_MODEL=gemini-3.5-flash
# Used once if GEMINI_MODEL returns 404.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=15000
# Fast model for "Guide me" aiming (about one call a second while aiming).
AIM_MODEL=gemini-3.1-flash-lite
AIM_TIMEOUT_MS=6000

# Voice for /api/speak. "gemini" (default): a Gemini text-to-speech model with the
# same credentials as describe (key or Vertex AI), falling back to Cloud TTS below.
# "cloud": Cloud TTS only. With neither, the app uses the phone's own voice.
SPEAK_ENGINE=gemini
# Tried first; if the project can't use it, the server tries the other current
# voice models in turn (see SPEAK_MODELS in lib/gemini/config.ts).
# Run `npm run voice-check` to see which ones work for your credentials.
SPEAK_MODEL=gemini-3.8-flash-tts
SPEAK_FALLBACK_MODEL=gemini-3.1-flash-tts-preview
# Gemini prebuilt voice, for example Kore, Aoede, Charon, Puck or Sulafat.
SPEAK_VOICE=Kore

# Google Cloud Text-to-Speech (for /api/speak). Falls back to GEMINI_API_KEY.
# The key's project needs the "Cloud Text-to-Speech API" enabled.
GOOGLE_TTS_API_KEY=
TTS_VOICE=en-US-Neural2-F
TTS_LANGUAGE=en-US
TTS_SPEAKING_RATE=1.0

# Per-IP requests per minute, per server instance. 0 turns a limit off.
RATE_LIMIT_DESCRIBE_PER_MIN=30
RATE_LIMIT_SPEAK_PER_MIN=180
RATE_LIMIT_AIM_PER_MIN=120
